# Copie para `.env` e ajuste o que precisar (todos os valores abaixo são os padrões).

# Pasta dos arquivos parquet
# DATA_DIR=./data

# Conta no opcoes.net.br (opcional). Com login: estudo de liquidez do site no ranking (4 requisições em vez
# de ~40) e IV calculada pelo site na cadeia. Ofertas de compra/venda (bid/ask) exigem assinatura Premium.
OPCOESNET_CPF=
OPCOESNET_SENHA=

# Taxa livre de risco anual: "auto" usa a Selic meta do Banco Central (série SGS 432)
TAXA_JUROS=auto
TAXA_JUROS_PADRAO=0.15

# Custos estimados por ordem
CUSTO_PCT=0.035          # % do volume financeiro (emolumentos + registro B3, aproximado)
CORRETAGEM_ORDEM=0       # R$ por ordem
CUSTO_TICK=0.01          # R$ por opção: meio spread estimado (o site não fornece book de ofertas sem login)
PREMIO_MIN=0.05          # prêmio mínimo por série nas estratégias

# Universo e coleta
ATIVOS_PADRAO=PETR4,VALE3,ITUB4,BBDC4,BBAS3,BOVA11,B3SA3,ABEV3,PRIO3,ITSA4
UNIVERSO_TOP_N=25        # nº de ativos mais líquidos acompanhados por padrão
VENC_MAX_DIAS=760        # ignora séries com vencimento mais distante
PAUSA_REQ=5.0            # segundos entre requisições ao opcoes.net.br (o site limita por IP)
ESPERA_MAX=120           # se o site pedir espera maior que isso (s), a coleta para e salva o que tem
UNIVERSO_VARREDURA=40    # nº de ativos (maiores em contratos em aberto) com volume medido no ranking
MANTER_CADEIAS_DIAS=400  # dias de cadeias arquivadas em data/cadeias
HIST_INICIO=2018-01-01   # início do histórico de preços (Yahoo Finance)

# Classificação de liquidez de cada série
LIQ_ALTA_NEGOCIOS=20
LIQ_ALTA_VOLUME=50000
LIQ_MEDIA_NEGOCIOS=5
LIQ_MEDIA_DIAS=2
